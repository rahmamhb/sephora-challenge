""},{"Key":"SFCC_DASHBOARD_JS","Value":"/* hide header & footer */ try { function removeUnusedElements() { var smartBanner = document.querySelector(\".smartbanner-show\"); if (smartBanner && smartBanner.style) { smartBanner.style.marginTop = \"0px\"; } var header = document.getElementsByTagName(\"header\"); if (header && header[1]) { header[0].remove(); } var backButton = document.querySelector(\".back-button-wrapper\"); if (backButton && backButton[0]) { backButton[0].remove(); } var footerTCPrivacy = document.querySelector(\"#footer_tc_privacy\"); if (footerTCPrivacy) { footerTCPrivacy.remove(); } var footer = document.getElementsByTagName(\"footer\"); if (footer && footer[0]) { footer[0].remove(); } /* custom css rule to hide nodes for app */ var style = document.createElement(\"style\"); document.head.appendChild(style); style.sheet.insertRule(\".nonVisibleApp { display:none; }\"); style.sheet.insertRule(\".ab_banner_template,header, .footer-item,.footer-mobile-app,.footer-reinssurance-mobile, .footer-mobile-app, .footer-reinssurance-mobile, .nonVisibleApp { display:none;}\"); } window.load = removeUnusedElements(); } catch (error) { true; }; var overlayTCPrivacy = document.querySelector(\"#tc-privacy-overlay-banner\"); if (overlayTCPrivacy) { overlayTCPrivacy.remove(); } document.querySelectorAll(\".loyalty-dashboard-head\").forEach(el => el.remove());","Description":""},{"Key":"MY_SEPHORA_LOYALTY_DASHBOARD_URL","Value":"https://www.sephora.fr/on/demandware.store/Sites-Sephora_FR-Site/fr_FR/LoyaltyDashboard-Show","Description":""},{"Key":"MFA_CHALLENGE_WEB_VIEW_URL","Value":"https://www.sephora.fr/on/demandware.store/Sites-Sephora_FR-Site/fr_FR/Account-SendMfaForEmailUpdate?customerId={{customer_id}}&newEmail={{new_email}}","Description":""},{"Key":"special_character_regex","Value":".*([#@;¬≤|&\\\"()!_$‚Ç¨¬£`+=\\r\\n\\t]|\\p{Emoji}).*","Description":""},{"Key":"security_regex","Value":"(?i)[\\s\\S]*(--|'|or\\s+'1'\\s*=\\s*'1'|\\bselect\\b|\\bdrop\\b|https?:\\/\