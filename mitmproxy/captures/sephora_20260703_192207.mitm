|71|72|78|79)[0-9]{6,7})$\",   \"KW\": \"^((?:1|2|5|6|9)[0-9]{7})$\" }","Description":""},{"Key":"products_pdp_loyalty_points_isActive","Value":"true","Description":""},{"Key":"DISABLE_ACCOUNT_COMMUNICATIONS","Value":"false","Description":""},{"Key":"ENABLE_OPTIN_PHONE","Value":"true","Description":""},{"Key":"ALLOW_MULTIPLE_COUPON_ON_ORDER","Value":"false","Description":""},{"Key":"CLIENT_SERVICE_PHONE_NUMBER","Value":"0 809 40 40 45","Description":""},{"Key":"SERVICE_CLIENT_CALL_ENABLED","Value":"true","Description":""},{"Key":"OFFER_EXPIRES_IN_DAYS","Value":"5","Description":""},{"Key":"BRANDS_NO_CROSSED_PRICE","Value":".","Description":""},{"Key":"Activate_booxie","Value":"true","Description":""},{"Key":"DISCOVER_LOYALTY_PROGRAM_URL","Value":"https://www.sephora.fr/Programme-carte-fidelite.html","Description":""},{"Key":"IS_APPOINTMENT_DISPLAYED","Value":"true","Description":""},{"Key":"SHOW_COOKIE_BANNER","Value":"true","Description":""},{"Key":"CGU_REVIEWS","Value":"https://www.sephora.fr/on/demandware.static/-/Library-Sites-SephoraV2/default/dw4563c1ad/customerfeedback/conditons-generales-avis-consommateurs-charte-associee.pdf","Description":""},{"Key":"DISABLE_COOKIES_BANNER_SETTINGS_ENTRY","Value":"false","Description":""},{"Key":"ADVENT_CALENDAR_URL","Value":"https://www.sephora.fr/calendrier-avent-diy-app/","Description":""},{"Key":"ADVENT_CALENDAR_ADD_TO_BASKET_TRIGGER","Value":"/multiproduct","Description":""},{"Key":"IS_WOOSMAP_ACTIVE","Value":"true","Description":""},{"Key":"WOOSMAP_DEV_KEY","Value":"2928c6b6-797b-4669-b457-e2ae51a92709","Description":""},{"Key":"enableNewSubscriptionJourney","Value":"true","Description":""},{"Key":"CAN_ACTIVATE_LOYALTY","Value":"true","Description":""},{"Key":"NOT_ALLOWED_CHARS ","Value":"^[^/]*$","Description":""},{"Key":"ENABLE_SAMPLES_NUMBER_PER_AMOUNT","Value":"true","Description":""},{"Key":"DELETE_ACCOUNT_EMAIL_RECIPIENT","Value":"privacy@sephora.fr","Description":""},{"Key":"IS_DQE_FOR_PHONE_ACTIVATED","Value"